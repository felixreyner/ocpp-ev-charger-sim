{
  "name": "ocpp-ev-charger-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Learn OCPP by watching a simulated EV charger talk to a simulated central system (CSMS). Supports OCPP 1.6J and 2.0.1.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n csms,charger,rogue,demo -c magenta,cyan,red,yellow \"npm:dev:csms\" \"npm:dev:charger\" \"npm:dev:rogue\" \"npm:dev:demo\"",
    "dev:csms": "npm run dev -w @sim/csms",
    "dev:charger": "npm run dev -w @sim/charger",
    "dev:rogue": "npm run dev -w @sim/rogue",
    "dev:demo": "npm run dev -w @sim/demo",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "specs": "tsx specs/src/build.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
