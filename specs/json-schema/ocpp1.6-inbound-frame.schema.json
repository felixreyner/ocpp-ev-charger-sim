{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/felixreyner/ocpp-ev-charger-sim/specs/json-schema/ocpp1.6-inbound-frame.schema.json",
  "title": "OCPP 1.6J frame, charging station → CSMS",
  "description": "Validates one complete OCPP-J WebSocket text message that a charging station sends to this CSMS over subprotocol \"ocpp1.6\". Valid frames are [2, messageId, Action, payload] (CALL), [3, messageId, payload] (CALLRESULT answering a CSMS command) or [4, messageId, errorCode, description, details] (CALLERROR). Anything else (non-JSON, wrong array shape, unknown message type, unknown action, extra or mistyped fields, out-of-range values) does not validate. Generated by `npm run specs` from specs/src/schemas.ts. Do not edit by hand.",
  "oneOf": [
    {
      "title": "CALL BootNotification",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "BootNotification"
          ]
        },
        {
          "$ref": "#/$defs/V16_BootNotification_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL Heartbeat",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "Heartbeat"
          ]
        },
        {
          "$ref": "#/$defs/V16_Heartbeat_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL StatusNotification",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "StatusNotification"
          ]
        },
        {
          "$ref": "#/$defs/V16_StatusNotification_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL Authorize",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "Authorize"
          ]
        },
        {
          "$ref": "#/$defs/V16_Authorize_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL StartTransaction",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "StartTransaction"
          ]
        },
        {
          "$ref": "#/$defs/V16_StartTransaction_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL StopTransaction",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "StopTransaction"
          ]
        },
        {
          "$ref": "#/$defs/V16_StopTransaction_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALL MeterValues",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            2
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "string",
          "enum": [
            "MeterValues"
          ]
        },
        {
          "$ref": "#/$defs/V16_MeterValues_Request"
        }
      ],
      "items": false
    },
    {
      "title": "CALLRESULT (answer to a command the CSMS sent)",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            3
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/V16_RemoteStartTransaction_Response"
            },
            {
              "$ref": "#/$defs/V16_RemoteStopTransaction_Response"
            },
            {
              "$ref": "#/$defs/V16_Reset_Response"
            },
            {
              "$ref": "#/$defs/V16_UnlockConnector_Response"
            },
            {
              "$ref": "#/$defs/V16_ChangeAvailability_Response"
            },
            {
              "$ref": "#/$defs/V16_SetChargingProfile_Response"
            },
            {
              "$ref": "#/$defs/V16_ClearChargingProfile_Response"
            },
            {
              "$ref": "#/$defs/V16_TriggerMessage_Response"
            }
          ]
        }
      ],
      "items": false
    },
    {
      "title": "CALLERROR",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "integer",
          "enum": [
            4
          ]
        },
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "$ref": "#/$defs/V16_ErrorCode"
        },
        {
          "$ref": "#/$defs/ErrorDescription"
        },
        {
          "$ref": "#/$defs/ErrorDetails"
        }
      ],
      "items": false
    }
  ],
  "$defs": {
    "MessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[\\x21-\\x7E]{1,36}$",
      "description": "Unique message id; a response repeats the id of the request it answers"
    },
    "V16_SampledValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^[0-9]{1,9}(\\.[0-9]{1,6})?$",
              "description": "Decimal number as a string"
            },
            "measurand": {
              "type": "string",
              "enum": [
                "Current.Export",
                "Current.Import",
                "Current.Offered",
                "Energy.Active.Export.Register",
                "Energy.Active.Import.Register",
                "Energy.Reactive.Export.Register",
                "Energy.Reactive.Import.Register",
                "Energy.Active.Export.Interval",
                "Energy.Active.Import.Interval",
                "Energy.Reactive.Export.Interval",
                "Energy.Reactive.Import.Interval",
                "Frequency",
                "Power.Active.Export",
                "Power.Active.Import",
                "Power.Offered",
                "Power.Reactive.Export",
                "Power.Reactive.Import",
                "RPM",
                "Voltage"
              ]
            },
            "context": {
              "type": "string",
              "enum": [
                "Interruption.Begin",
                "Interruption.End",
                "Other",
                "Sample.Clock",
                "Sample.Periodic",
                "Transaction.Begin",
                "Transaction.End",
                "Trigger"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "Raw",
                "SignedData"
              ]
            },
            "phase": {
              "type": "string",
              "enum": [
                "L1",
                "L2",
                "L3",
                "N",
                "L1-N",
                "L2-N",
                "L3-N",
                "L1-L2",
                "L2-L3",
                "L3-L1"
              ]
            },
            "location": {
              "type": "string",
              "enum": [
                "Body",
                "Cable",
                "EV",
                "Inlet",
                "Outlet"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "Wh",
                "kWh",
                "varh",
                "kvarh",
                "W",
                "kW",
                "VA",
                "kVA",
                "var",
                "kvar",
                "A",
                "V",
                "K",
                "Celcius",
                "Celsius",
                "Fahrenheit",
                "Percent"
              ]
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "title": "Energy, power, current or voltage reading (non-negative)"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^(100(\\.0{1,6})?|[0-9]{1,2}(\\.[0-9]{1,6})?)$",
              "description": "Decimal number as a string"
            },
            "measurand": {
              "type": "string",
              "enum": [
                "SoC"
              ]
            },
            "context": {
              "type": "string",
              "enum": [
                "Interruption.Begin",
                "Interruption.End",
                "Other",
                "Sample.Clock",
                "Sample.Periodic",
                "Transaction.Begin",
                "Transaction.End",
                "Trigger"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "Raw",
                "SignedData"
              ]
            },
            "phase": {
              "type": "string",
              "enum": [
                "L1",
                "L2",
                "L3",
                "N",
                "L1-N",
                "L2-N",
                "L3-N",
                "L1-L2",
                "L2-L3",
                "L3-L1"
              ]
            },
            "location": {
              "type": "string",
              "enum": [
                "Body",
                "Cable",
                "EV",
                "Inlet",
                "Outlet"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "Wh",
                "kWh",
                "varh",
                "kvarh",
                "W",
                "kW",
                "VA",
                "kVA",
                "var",
                "kvar",
                "A",
                "V",
                "K",
                "Celcius",
                "Celsius",
                "Fahrenheit",
                "Percent"
              ]
            }
          },
          "required": [
            "value",
            "measurand"
          ],
          "additionalProperties": false,
          "title": "State of charge in percent (0-100)"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^-?[0-9]{1,7}(\\.[0-9]{1,6})?$",
              "description": "Decimal number as a string"
            },
            "measurand": {
              "type": "string",
              "enum": [
                "Power.Factor",
                "Temperature"
              ]
            },
            "context": {
              "type": "string",
              "enum": [
                "Interruption.Begin",
                "Interruption.End",
                "Other",
                "Sample.Clock",
                "Sample.Periodic",
                "Transaction.Begin",
                "Transaction.End",
                "Trigger"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "Raw",
                "SignedData"
              ]
            },
            "phase": {
              "type": "string",
              "enum": [
                "L1",
                "L2",
                "L3",
                "N",
                "L1-N",
                "L2-N",
                "L3-N",
                "L1-L2",
                "L2-L3",
                "L3-L1"
              ]
            },
            "location": {
              "type": "string",
              "enum": [
                "Body",
                "Cable",
                "EV",
                "Inlet",
                "Outlet"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "Wh",
                "kWh",
                "varh",
                "kvarh",
                "W",
                "kW",
                "VA",
                "kVA",
                "var",
                "kvar",
                "A",
                "V",
                "K",
                "Celcius",
                "Celsius",
                "Fahrenheit",
                "Percent"
              ]
            }
          },
          "required": [
            "value",
            "measurand"
          ],
          "additionalProperties": false,
          "title": "Signed reading (power factor, temperature)"
        }
      ]
    },
    "V16_ErrorCode": {
      "type": "string",
      "enum": [
        "NotImplemented",
        "NotSupported",
        "InternalError",
        "ProtocolError",
        "SecurityError",
        "FormationViolation",
        "PropertyConstraintViolation",
        "OccurenceConstraintViolation",
        "TypeConstraintViolation",
        "GenericError"
      ]
    },
    "ErrorDescription": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x1F\\x7F]*$"
    },
    "ErrorDetails": {
      "type": "object",
      "maxProperties": 20,
      "description": "Free-form error details object"
    },
    "V16_BootNotification_Request": {
      "title": "OCPP 1.6J BootNotification request (charger → CSMS)",
      "type": "object",
      "properties": {
        "chargePointVendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[^\\x00-\\x1F\\x7F]{1,20}$"
        },
        "chargePointModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[^\\x00-\\x1F\\x7F]{1,20}$"
        },
        "chargePointSerialNumber": {
          "type": "string",
          "maxLength": 25,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "chargeBoxSerialNumber": {
          "type": "string",
          "maxLength": 25,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "firmwareVersion": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "iccid": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "imsi": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "meterType": {
          "type": "string",
          "maxLength": 25,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "meterSerialNumber": {
          "type": "string",
          "maxLength": 25,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        }
      },
      "required": [
        "chargePointVendor",
        "chargePointModel"
      ],
      "additionalProperties": false
    },
    "V16_BootNotification_Response": {
      "title": "OCPP 1.6J BootNotification response (CSMS → charger)",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Accepted",
            "Pending",
            "Rejected"
          ]
        },
        "currentTime": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
        },
        "interval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "status",
        "currentTime",
        "interval"
      ],
      "additionalProperties": false
    },
    "V16_Heartbeat_Request": {
      "title": "OCPP 1.6J Heartbeat request (charger → CSMS)",
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "maxProperties": 0
    },
    "V16_Heartbeat_Response": {
      "title": "OCPP 1.6J Heartbeat response (CSMS → charger)",
      "type": "object",
      "properties": {
        "currentTime": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
        }
      },
      "required": [
        "currentTime"
      ],
      "additionalProperties": false
    },
    "V16_StatusNotification_Request": {
      "title": "OCPP 1.6J StatusNotification request (charger → CSMS)",
      "type": "object",
      "properties": {
        "connectorId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = the whole charge point"
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "ConnectorLockFailure",
            "EVCommunicationError",
            "GroundFailure",
            "HighTemperature",
            "InternalError",
            "LocalListConflict",
            "NoError",
            "OtherError",
            "OverCurrentFailure",
            "PowerMeterFailure",
            "PowerSwitchFailure",
            "ReaderFailure",
            "ResetFailure",
            "UnderVoltage",
            "OverVoltage",
            "WeakSignal"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "Available",
            "Preparing",
            "Charging",
            "SuspendedEVSE",
            "SuspendedEV",
            "Finishing",
            "Reserved",
            "Unavailable",
            "Faulted"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
        },
        "info": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "vendorId": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        },
        "vendorErrorCode": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[^\\x00-\\x1F\\x7F]*$"
        }
      },
      "required": [
        "connectorId",
        "errorCode",
        "status"
      ],
      "additionalProperties": false
    },
    "V16_StatusNotification_Response": {
      "title": "OCPP 1.6J StatusNotification response (CSMS → charger)",
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "maxProperties": 0
    },
    "V16_Authorize_Request": {
      "title": "OCPP 1.6J Authorize request (charger → CSMS)",
      "type": "object",
      "properties": {
        "idTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[\\x21-\\x7E]{1,20}$",
          "description": "RFID card / token id (CiString20)"
        }
      },
      "required": [
        "idTag"
      ],
      "additionalProperties": false
    },
    "V16_Authorize_Response": {
      "title": "OCPP 1.6J Authorize response (CSMS → charger)",
      "type": "object",
      "properties": {
        "idTagInfo": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "Accepted",
                "Blocked",
                "Expired",
                "Invalid",
                "ConcurrentTx"
              ]
            },
            "expiryDate": {
              "type": "string",
              "format": "date-time",
              "maxLength": 35,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
            },
            "parentIdTag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[\\x21-\\x7E]{1,20}$",
              "description": "RFID card / token id (CiString20)"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "idTagInfo"
      ],
      "additionalProperties": false
    },
    "V16_StartTransaction_Request": {
      "title": "OCPP 1.6J StartTransaction request (charger → CSMS)",
      "type": "object",
      "properties": {
        "connectorId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "idTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[\\x21-\\x7E]{1,20}$",
          "description": "RFID card / token id (CiString20)"
        },
        "meterStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999,
          "description": "Meter register at start, in Wh"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
        },
        "reservationId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "connectorId",
        "idTag",
        "meterStart",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "V16_StartTransaction_Response": {
      "title": "OCPP 1.6J StartTransaction response (CSMS → charger)",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "idTagInfo": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "Accepted",
                "Blocked",
                "Expired",
                "Invalid",
                "ConcurrentTx"
              ]
            },
            "expiryDate": {
              "type": "string",
              "format": "date-time",
              "maxLength": 35,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "RFC 3339 date-time, e.g. 2026-01-31T12:00:00.000Z"
            },
            "parentIdTag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[\\x21-\\x7E]{1,20}$",
